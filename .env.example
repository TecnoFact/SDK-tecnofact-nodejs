# TecnoFact SDK — configuración de entorno
# Necesario para Config.fromEnvironment()

TECN_FACT_EMAIL=tu_email@tudominio.com
TECN_FACT_PASSWORD=tu_password
TECN_FACT_ENVIRONMENT=production
TECN_FACT_TIMEOUT=30
TECN_FACT_RETRIES=3
# TECN_FACT_VERIFY_SSL=true
# Para usar un bundle de CA propio:
# TECN_FACT_VERIFY_SSL=/ruta/al/ca-bundle.pem
# Para desarrollo (INSEGURO, no usar en producción):
# TECN_FACT_VERIFY_SSL=false